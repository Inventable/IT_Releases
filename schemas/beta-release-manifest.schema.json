{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Inventable/IT_Releases/main/schemas/beta-release-manifest.schema.json",
  "title": "Northstar Gauge engineering beta release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "channel",
    "suiteVersion",
    "generatedUtc",
    "source",
    "applications",
    "firmware",
    "additionalAssets"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "channel": { "const": "beta" },
    "suiteVersion": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d+\\.\\d+-beta$"
    },
    "generatedUtc": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "dirty"],
      "properties": {
        "repository": { "const": "Inventable/Gauge_Product_Family" },
        "commit": { "$ref": "#/$defs/commit" },
        "dirty": { "const": false }
      }
    },
    "applications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "version", "url", "sha256", "releaseNotes"],
        "properties": {
          "platform": { "type": "string", "minLength": 1 },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+-beta$"
          },
          "url": { "$ref": "#/$defs/url" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "releaseNotes": { "type": "string" }
        }
      }
    },
    "firmware": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deviceType",
          "supportedPcbs",
          "version",
          "imageType",
          "processor",
          "minimumBootloader",
          "url",
          "sha256",
          "releaseNotes"
        ],
        "properties": {
          "deviceType": { "type": "integer", "minimum": 1 },
          "supportedPcbs": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1 },
            "uniqueItems": true
          },
          "version": { "type": "string", "minLength": 1 },
          "imageType": { "const": "offset-production" },
          "processor": { "const": "PIC18F26K80" },
          "minimumBootloader": { "type": "string", "minLength": 1 },
          "url": { "$ref": "#/$defs/url" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "releaseNotes": { "type": "string" }
        }
      }
    },
    "additionalAssets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["audience", "version", "url", "sha256"],
        "properties": {
          "audience": { "type": "string", "minLength": 1 },
          "kind": { "type": "string" },
          "imageType": { "type": "string" },
          "version": { "type": "string", "minLength": 1 },
          "url": { "$ref": "#/$defs/url" },
          "sha256": { "$ref": "#/$defs/sha256" }
        },
        "oneOf": [
          { "required": ["kind"] },
          { "required": ["imageType"] }
        ]
      }
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    }
  }
}
